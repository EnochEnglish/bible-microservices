<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 600" width="800" height="600">
  <rect width="800" height="600" fill="#fdf6e3"/>
  <text x="400" y="28" text-anchor="middle" font-family="serif" font-size="20" font-weight="bold" fill="#333">Kingdoms of Israel &amp; Judah / 以色列与犹大王国</text>
  <text x="400" y="48" text-anchor="middle" font-family="serif" font-size="12" fill="#666">Divided Kingdom · c. 930–722 BC · 1 Kings 12</text>
  <!-- Mediterranean -->
  <polygon points="0,60 180,60 190,70 180,90 160,130 120,160 80,180 30,200 0,200" fill="#4a90d9" opacity="0.35"/>
  <!-- Sea of Galilee -->
  <ellipse cx="300" cy="180" rx="25" ry="12" fill="#4a90d9" opacity="0.5"/>
  <text x="330" y="185" font-family="serif" font-size="8" fill="#2c5f9e">Sea of Galilee</text>
  <!-- Jordan -->
  <path d="M300,192 295,230 290,270 295,320 300,370 305,420" fill="none" stroke="#4a90d9" stroke-width="2"/>
  <!-- Dead Sea -->
  <ellipse cx="305" cy="440" rx="18" ry="35" fill="#4a90d9" opacity="0.5"/>
  <text x="330" y="445" font-family="serif" font-size="7" fill="#2c5f9e">Dead Sea</text>
  <!-- Israel (Northern Kingdom) outline -->
  <polygon points="160,140 400,140 400,300 365,320 300,300 160,260" fill="#ffd4a0" stroke="#e67e22" stroke-width="2.5" opacity="0.6"/>
  <text x="280" y="220" font-family="serif" font-size="20" font-weight="bold" fill="#d35400">ISRAEL</text>
  <text x="280" y="240" font-family="serif" font-size="11" fill="#d35400">以色列 (Northern)</text>
  <!-- Judah (Southern Kingdom) -->
  <polygon points="160,260 300,300 300,420 360,440 360,500 160,500" fill="#fff9c4" stroke="#f1c40f" stroke-width="2.5" opacity="0.6"/>
  <text x="220" y="380" font-family="serif" font-size="20" font-weight="bold" fill="#b8860b">JUDAH</text>
  <text x="220" y="400" font-family="serif" font-size="11" fill="#b8860b">犹大 (Southern)</text>
  <!-- Philistia -->
  <polygon points="120,280 160,280 160,400 130,420 110,380" fill="#e8e0d0" stroke="#999" stroke-width="1"/>
  <text x="135" y="350" font-family="serif" font-size="9" fill="#666">Philistia</text>
  <!-- Phoenicia -->
  <rect x="180" y="100" width="80" height="50" rx="3" fill="#d5e8d4" stroke="#82b366" stroke-width="0.8"/>
  <text x="220" y="130" font-family="serif" font-size="9" fill="#2d5e0a">Phoenicia</text>
  <!-- Aram -->
  <rect x="400" y="100" width="100" height="80" rx="3" fill="#e8d5a3" stroke="#b8960c" stroke-width="0.8"/>
  <text x="450" y="145" font-family="serif" font-size="12" fill="#8b6914">Aram</text>
  <text x="450" y="160" font-family="serif" font-size="9" fill="#8b6914">(Syria)</text>
  <!-- Ammon / Moab / Edom -->
  <polygon points="400,300 500,320 500,380 400,380" fill="#e8d5a3" stroke="#999" stroke-width="0.8"/>
  <text x="440" y="345" font-family="serif" font-size="9" fill="#666">Ammon</text>
  <polygon points="400,380 500,400 500,460 400,440" fill="#e8c860" stroke="#999" stroke-width="0.8"/>
  <text x="440" y="425" font-family="serif" font-size="9" fill="#666">Moab</text>
  <polygon points="370,440 430,460 430,520 360,500" fill="#eddea4" stroke="#999" stroke-width="0.8"/>
  <text x="395" y="480" font-family="serif" font-size="9" fill="#666">Edom</text>
  <!-- Capital Cities -->
  <circle cx="370" cy="200" r="5" fill="#c0392b"/>
  <text x="380" y="195" font-family="serif" font-size="10" fill="#333">Samaria</text>
  <circle cx="250" cy="370" r="6" fill="#c0392b"/>
  <text x="220" y="378" font-family="serif" font-size="10" fill="#333">Jerusalem</text>
  <!-- Other cities -->
  <circle cx="200" cy="280" r="4" fill="#8b4513"/>
  <text x="168" y="288" font-family="serif" font-size="8" fill="#333">Gezer</text>
  <circle cx="280" cy="340" r="3" fill="#8b4513"/>
  <text x="260" y="350" font-family="serif" font-size="8" fill="#333">Jericho</text>
  <circle cx="300" cy="250" r="4" fill="#8b4513"/>
  <text x="308" y="254" font-family="serif" font-size="8" fill="#333">Tirzah</text>
  <circle cx="210" cy="440" r="4" fill="#8b4513"/>
  <text x="180" y="448" font-family="serif" font-size="8" fill="#333">Hebron</text>
  <circle cx="340" cy="450" r="3" fill="#8b4513"/>
  <text x="348" y="454" font-family="serif" font-size="8" fill="#333">Beer-sheba</text>
  <circle cx="420" cy="155" r="4" fill="#8b4513"/>
  <text x="428" y="159" font-family="serif" font-size="8" fill="#333">Damascus</text>
  <circle cx="270" cy="420" r="3" fill="#8b4513"/>
  <text x="278" y="424" font-family="serif" font-size="8" fill="#333">En-gedi</text>
  <rect x="10" y="520" width="220" height="70" rx="4" fill="white" stroke="#ccc"/>
  <text x="20" y="540" font-family="serif" font-size="9" fill="#333">Divided after Solomon · Rehoboam &amp; Jeroboam</text>
  <text x="20" y="558" font-family="serif" font-size="8" fill="#666">1 Kings 12:1-24 · Israel fell to Assyria 722 BC</text>
</svg>
