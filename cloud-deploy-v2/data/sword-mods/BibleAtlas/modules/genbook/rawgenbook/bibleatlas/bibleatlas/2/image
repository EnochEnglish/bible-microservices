<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 600" width="800" height="600">
  <rect width="800" height="600" fill="#fdf6e3"/>
  <text x="400" y="28" text-anchor="middle" font-family="serif" font-size="20" font-weight="bold" fill="#333">The Exodus Route / 出埃及路线</text>
  <text x="400" y="48" text-anchor="middle" font-family="serif" font-size="12" fill="#666">From Egypt to Canaan · c. 1446 BC · Numbers 33</text>
  <!-- Mediterranean -->
  <polygon points="0,60 200,60 220,90 200,130 160,160 100,180 30,180 0,180" fill="#4a90d9" opacity="0.4"/>
  <!-- Egypt (Nile Delta) -->
  <polygon points="60,140 180,140 190,180 170,220 140,260 80,280 50,260 60,180" fill="#e8c860" stroke="#b8960c" stroke-width="1.5"/>
  <text x="100" y="200" font-family="serif" font-size="15" font-weight="bold" fill="#8b6914">Egypt</text>
  <circle cx="100" cy="175" r="5" fill="#c0392b"/>
  <text x="110" y="170" font-family="serif" font-size="9" fill="#333">Rameses</text>
  <!-- Nile branches -->
  <path d="M120,150 L110,230 M90,150 L85,240" fill="none" stroke="#4a90d9" stroke-width="1.5"/>
  <!-- Sinai Peninsula -->
  <polygon points="210,140 330,140 330,280 300,320 240,340 210,280" fill="#d4c37a" stroke="#b8960c" stroke-width="1"/>
  <text x="270" y="240" font-family="serif" font-size="10" fill="#8b6914">Wilderness of Sin</text>
  <!-- Gulf of Suez -->
  <polygon points="180,300 220,340 240,400 210,500 180,500" fill="#4a90d9" opacity="0.5"/>
  <text x="180" y="400" font-family="serif" font-size="8" fill="#2c5f9e">Gulf of Suez</text>
  <!-- Gulf of Aqaba -->
  <polygon points="330,340 370,380 370,500 330,500" fill="#4a90d9" opacity="0.5"/>
  <!-- Canaan -->
  <rect x="300" y="80" width="90" height="100" rx="5" fill="#a8d87a" stroke="#5a9830" stroke-width="1.5"/>
  <text x="330" y="130" font-family="serif" font-size="14" font-weight="bold" fill="#2d5e0a">Canaan</text>
  <text x="315" y="146" font-family="serif" font-size="9" fill="#2d5e0a">迦南</text>
  <circle cx="370" cy="110" r="4" fill="#c0392b"/>
  <text x="378" y="114" font-family="serif" font-size="8" fill="#333">Jericho</text>
  <!-- Dead Sea -->
  <ellipse cx="380" cy="210" rx="15" ry="30" fill="#4a90d9" opacity="0.5"/>
  <text x="405" y="214" font-family="serif" font-size="7" fill="#2c5f9e">Dead Sea</text>
  <!-- Edom/Moab -->
  <polygon points="370,250 450,240 460,320 380,340" fill="#e8d5a3" stroke="#b8960c" stroke-width="0.8"/>
  <text x="400" y="285" font-family="serif" font-size="9" fill="#8b6914">Edom</text>
  <text x="400" y="310" font-family="serif" font-size="9" fill="#8b6914">Moab</text>
  <!-- Midian -->
  <polygon points="370,380 450,370 460,450 370,480" fill="#eddea4" stroke="#b8960c" stroke-width="0.8"/>
  <text x="400" y="420" font-family="serif" font-size="9" fill="#8b6914">Midian</text>
  <!-- mt sinai -->
  <circle cx="300" cy="380" r="5" fill="#c0392b"/>
  <text x="308" y="384" font-family="serif" font-size="9" fill="#333">Mt. Sinai</text>
  <text x="308" y="396" font-family="serif" font-size="7" fill="#666">(Jebel Musa)</text>
  <!-- Route path -->
  <path d="M100,175 L130,190 L170,200 L200,220 L230,250 L260,280 L280,340 L290,370 L300,380 L320,400 L350,400 L370,380 L370,340 L380,280 L370,220 L370,110" fill="none" stroke="#e74c3c" stroke-width="2.5" stroke-dasharray="8,4" marker-end="url(#arrow)"/>
  <defs><marker id="arrow" viewBox="0 0 10 10" refX="5" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse"><path d="M 0 0 L 10 5 L 0 10 z" fill="#e74c3c"/></marker></defs>
  <!-- Route labels -->
  <text x="130" y="185" font-family="serif" font-size="8" fill="#e74c3c">Succoth</text>
  <circle cx="230" cy="250" r="3" fill="#e74c3c"/>
  <text x="236" y="254" font-family="serif" font-size="8" fill="#e74c3c">Marah</text>
  <circle cx="260" cy="280" r="3" fill="#e74c3c"/>
  <text x="266" y="284" font-family="serif" font-size="8" fill="#e74c3c">Elim</text>
  <circle cx="320" cy="340" r="3" fill="#e74c3c"/>
  <text x="326" y="344" font-family="serif" font-size="8" fill="#e74c3c">Rephidim</text>
  <circle cx="350" cy="400" r="3" fill="#e74c3c"/>
  <text x="356" y="404" font-family="serif" font-size="8" fill="#e74c3c">Kadesh-barnea</text>
  <circle cx="420" cy="380" r="3" fill="#e74c3c"/>
  <text x="426" y="384" font-family="serif" font-size="8" fill="#e74c3c">Punon</text>
  <circle cx="400" cy="300" r="3" fill="#e74c3c"/>
  <text x="370" y="295" font-family="serif" font-size="8" fill="#e74c3c">Dibon</text>
  <circle cx="370" cy="240" r="3" fill="#e74c3c"/>
  <text x="335" y="236" font-family="serif" font-size="8" fill="#e74c3c">Mt. Nebo</text>
  <text x="520" y="140" font-family="serif" font-size="9" fill="#333">Ex 12:37  Numbers 33</text>
  <!-- Red Sea crossing -->
  <text x="180" y="280" font-family="serif" font-size="7" fill="#e74c3c" transform="rotate(-30,180,280)">Red Sea Crossing</text>
</svg>
