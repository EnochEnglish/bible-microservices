  <circle cx="225" cy="320" r="3" fill="#c0392b"/>
  <text x="190" y="328" font-family="serif" font-size="8" fill="#333">Caesarea</text>
  <circle cx="215" cy="165" r="3" fill="#c0392b"/>
  <text x="180" y="169" font-family="serif" font-size="8" fill="#333">Tyre</text>
  <circle cx="260" cy="255" r="3" fill="#c0392b"/>
  <text x="268" y="259" font-family="serif" font-size="8" fill="#333">Scythopolis</text>
  <text x="520" y="200" font-family="serif" font-size="9" fill="#333" font-style="italic">"He went throughout</text>
  <text x="520" y="216" font-family="serif" font-size="9" fill="#333" font-style="italic">all Galilee, teaching"</text>
  <text x="520" y="232" font-family="serif" font-size="8" fill="#666">— Matthew 4:23</text>
</svg>
