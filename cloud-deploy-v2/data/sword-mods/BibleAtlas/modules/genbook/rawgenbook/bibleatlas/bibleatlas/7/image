<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 600" width="800" height="600">
  <rect width="800" height="600" fill="#fdf6e3"/>
  <text x="400" y="28" text-anchor="middle" font-family="serif" font-size="20" font-weight="bold" fill="#333">Paul's Second &amp; Third Journeys / 保罗第二三次宣教旅程</text>
  <!-- Mediterranean -->
  <rect x="0" y="0" width="800" height="600" fill="#4a90d9" opacity="0.10"/>
  <!-- Italy -->
  <polygon points="50,100 150,120 170,100 120,60" fill="#e8d5a3" stroke="#999" stroke-width="0.8"/>
  <text x="100" y="95" font-family="serif" font-size="8" fill="#666">Italy</text>
  <circle cx="80" cy="100" r="5" fill="#c0392b"/>
  <text x="60" y="115" font-family="serif" font-size="8" fill="#333">Rome</text>
  <!-- Greece -->
  <polygon points="180,90 250,100 260,140 230,170 180,160" fill="#e8d5a3" stroke="#999" stroke-width="0.8"/>
  <text x="210" y="130" font-family="serif" font-size="10" fill="#666">Greece</text>
  <!-- Macedonia -->
  <polygon points="250,90 320,95 330,130 280,140" fill="#dcedc8" stroke="#5a9830" stroke-width="1"/>
  <text x="290" y="115" font-family="serif" font-size="9" fill="#2d5e0a">Macedonia</text>
  <!-- Achaia -->
  <polygon points="230,150 280,140 290,170 230,170" fill="#d4c37a" stroke="#999" stroke-width="0.8"/>
  <text x="250" y="165" font-family="serif" font-size="8" fill="#666">Achaia</text>
  <!-- Asia Minor -->
  <polygon points="320,90 460,100 480,150 440,180 380,180 320,170" fill="#e8d5a3" stroke="#b8960c" stroke-width="1"/>
  <text x="390" y="140" font-family="serif" font-size="12" font-weight="bold" fill="#8b6914">Asia Minor</text>
  <!-- Syria -->
  <polygon points="580,120 660,130 680,180 600,190" fill="#dcedc8" stroke="#5a9830" stroke-width="0.8"/>
  <text x="630" y="160" font-family="serif" font-size="9" fill="#2d5e0a">Syria</text>
  <!-- Judea -->
  <rect x="620" y="200" width="40" height="40" rx="3" fill="#ffe0b2" stroke="#e65100" stroke-width="0.8"/>
  <text x="640" y="225" font-family="serif" font-size="8" fill="#bf360c">Judea</text>
  <!-- Galatia -->
  <polygon points="380,160 440,150 460,180 400,190" fill="#d4c37a" stroke="#999" stroke-width="0.8"/>
  <text x="420" y="175" font-family="serif" font-size="8" fill="#666">Galatia</text>
  <!-- Aegean Sea -->
  <polygon points="280,145 320,150 320,170 280,160" fill="#4a90d9" opacity="0.3"/>
  <text x="300" y="162" font-family="serif" font-size="7" fill="#2c5f9e">Aegean</text>
  <!-- Cities - Second Journey -->
  <circle cx="620" cy="140" r="5" fill="#c0392b"/>
  <text x="630" y="138" font-family="serif" font-size="8" fill="#333">Antioch</text>
  <circle cx="500" cy="108" r="4" fill="#c0392b"/>
  <text x="508" y="112" font-family="serif" font-size="8" fill="#333">Troas</text>
  <circle cx="290" cy="105" r="4" fill="#c0392b"/>
  <text x="270" y="98" font-family="serif" font-size="8" fill="#333">Philippi</text>
  <circle cx="270" cy="125" r="4" fill="#c0392b"/>
  <text x="278" y="129" font-family="serif" font-size="8" fill="#333">Thessalonica</text>
  <circle cx="250" cy="140" r="4" fill="#c0392b"/>
  <text x="258" y="144" font-family="serif" font-size="8" fill="#333">Berea</text>
  <circle cx="235" cy="155" r="4" fill="#c0392b"/>
  <text x="200" y="168" font-family="serif" font-size="8" fill="#333">Athens</text>
  <circle cx="250" cy="163" r="5" fill="#c0392b"/>
  <text x="220" y="178" font-family="serif" font-size="8" fill="#333">Corinth</text>
  <!-- Third Journey extra cities -->
  <circle cx="400" cy="115" r="4" fill="#3498db"/>
  <text x="408" y="119" font-family="serif" font-size="8" fill="#333">Ephesus</text>
  <circle cx="350" cy="105" r="3" fill="#3498db"/>
  <text x="358" y="109" font-family="serif" font-size="8" fill="#333">Smyrna</text>
  <circle cx="680" cy="220" r="4" fill="#3498db"/>
  <text x="690" y="224" font-family="serif" font-size="8" fill="#333">Jerusalem</text>
  <!-- Second Journey route -->
  <path d="M620,140 L550,120 L500,108" fill="none" stroke="#e74c3c" stroke-width="2" stroke-dasharray="6,3"/>
  <path d="M500,108 L290,105" fill="none" stroke="#e74c3c" stroke-width="2" stroke-dasharray="6,3"/>
  <path d="M290,105 L270,125 L250,140 L235,155 L250,163" fill="none" stroke="#e74c3c" stroke-width="2"/>
  <!-- Return: Corinth -> Ephesus -> Caesarea -> Jerusalem -> Antioch -->
  <path d="M250,163 L290,130 L400,115 L620,180" fill="none" stroke="#e74c3c" stroke-width="1.5" stroke-dasharray="4,4"/>
  <!-- Third Journey route (blue) -->
  <path d="M620,140 L480,120 L400,115 L350,105" fill="none" stroke="#3498db" stroke-width="2"/>
  <path d="M350,105 L400,115" fill="none" stroke="#3498db" stroke-width="2"/>
  <path d="M400,115 L290,105 L290,125 L270,125 L290,130 L400,115" fill="none" stroke="#3498db" stroke-width="1.5" stroke-dasharray="4,4"/>
  <path d="M400,115 L550,140 L620,180 L680,220" fill="none" stroke="#3498db" stroke-width="2" stroke-dasharray="6,3"/>
  <!-- Legend -->
  <rect x="10" y="500" width="320" height="90" rx="4" fill="white" stroke="#ccc"/>
  <line x1="20" y1="520" x2="50" y2="520" stroke="#e74c3c" stroke-width="2" stroke-dasharray="6,3"/>
  <text x="55" y="524" font-family="serif" font-size="9" fill="#333">Second Journey (Acts 15:36–18:22) c. AD 49–52</text>
  <line x1="20" y1="545" x2="50" y2="545" stroke="#3498db" stroke-width="2"/>
  <text x="55" y="549" font-family="serif" font-size="9" fill="#333">Third Journey (Acts 18:23–21:17) c. AD 53–57</text>
  <line x1="20" y1="570" x2="50" y2="570" stroke="#e74c3c" stroke-width="1.5" stroke-dasharray="4,4"/>
  <text x="55" y="574" font-family="serif" font-size="9" fill="#333">Return by sea</text>
</svg>
